<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[extensions [ gis ]

globals [
  ;; GIS datasets
  boundary-dataset
  wards-dataset
  roads-dataset
  hubs-dataset
  pop-dataset

  ;; Epidemic trackers
  count-S
  count-E
  count-I
  count-R
  cumulative-cases
  peak-infected
  peak-day
  effective-Rt
  recent-new-infections
  hospitalized-cases
  hospital-capacity

  ;; Time keeping
  simulation-day
  hour-of-day
  ticks-per-day
]

breed [ people person ]
breed [ hubs hub ]
breed [ quarantine-centers quarantine-center ]

people-own [
  health-status          ;; "S", "E", "I", "R"
  days-exposed           ;; hours/days in latent state
  days-infected          ;; hours/days in infectious state
  latent-duration        ;; threshold for E -> I
  infectious-duration    ;; threshold for I -> R
  home-patch-var         ;; home patch reference
  assigned-hub-var       ;; daytime hub destination
  current-target-patch   ;; target patch
  mobility-phase         ;; "home", "commuting-out", "at-hub", "commuting-in"
  dwell-hours-left       ;; hours remaining at hub
  is-isolated?           ;; in quarantine
  compliance-score       ;; 0.0 .. 1.0 adherence to restrictions
  is-mask-wearer?        ;; true/false
  ward-id                ;; 1 .. 39
  secondary-cases        ;; offspring cases for Rt calculation
]

hubs-own [
  hub-id
  hub-name
  hub-category           ;; "Healthcare", "Market", "Transit", "Education", "Religious", "Commercial", "Civic"
  hub-capacity
  hub-risk-score
  visitors-count
  infections-generated
  is-closed?
]

patches-own [
  pop-density            ;; from nedumangad_population.asc
  is-road?               ;; boolean
  road-hierarchy         ;; "primary", "secondary", "tertiary", "residential"
  ward-no                ;; 1..39
  cumulative-patch-cases ;; spatial infection tracker
]

;; ==========================================
;; SETUP PROCEDURES
;; ==========================================

to setup
  clear-all
  set ticks-per-day 24
  set simulation-day 1
  set hour-of-day 0
  set hospital-capacity 120
  set hospitalized-cases 0
  set peak-infected 0
  set peak-day 1
  set effective-Rt 1.50
  set recent-new-infections 0

  setup-gis
  setup-patches
  setup-hubs
  setup-population
  update-visual-display

  reset-ticks
  update-epidemic-metrics
  print (word "Nedumangad GIS Model Initialized: " count people " agents, " count hubs " activity hubs.")
end

to setup-gis
  ;; Load coordinate system and datasets
  gis:load-coordinate-system "data/nedumangad_boundary.prj"
  set boundary-dataset gis:load-dataset "data/nedumangad_boundary.shp"
  set wards-dataset gis:load-dataset "data/nedumangad_wards.shp"
  set roads-dataset gis:load-dataset "data/nedumangad_roads.shp"
  set hubs-dataset gis:load-dataset "data/nedumangad_hubs.shp"
  set pop-dataset gis:load-dataset "data/nedumangad_population.asc"

  ;; Set world envelope to encompass all datasets
  gis:set-world-envelope (gis:envelope-union-of
    (gis:envelope-of boundary-dataset)
    (gis:envelope-of roads-dataset)
    (gis:envelope-of pop-dataset))

  ;; Sample population density into patches
  gis:apply-raster pop-dataset pop-density
end

to setup-patches
  ask patches [
    set is-road? false
    set road-hierarchy "none"
    set cumulative-patch-cases 0
    set ward-no 0        ;; 0 = outside municipality
    if pop-density = false or pop-density < 0 [
      set pop-density 0.0
    ]
  ]

  ;; Assign real ward IDs to patches by intersecting GIS ward polygons
  let ward-features gis:feature-list-of wards-dataset
  let ward-counter 1
  foreach ward-features [ feat ->
    ask patches gis:intersecting feat [
      set ward-no ward-counter
    ]
    set ward-counter ward-counter + 1
  ]

  ;; Discretize roads onto patches for routing
  gis:set-drawing-color 35  ;; light orange
  gis:draw roads-dataset 1.0
end

to setup-hubs
  ;; Create hub turtles directly from GIS features
  let hub-features gis:feature-list-of hubs-dataset
  let counter 1

  foreach hub-features [ feat ->
    let vertex-lists gis:vertex-lists-of feat
    if not empty? vertex-lists [
      let first-poly first vertex-lists
      if not empty? first-poly [
        let loc gis:location-of first first-poly
        if not empty? loc [
          let hx item 0 loc
          let hy item 1 loc
          if (hx >= min-pxcor and hx <= max-pxcor and hy >= min-pycor and hy <= max-pycor) [
            create-hubs 1 [
              set xcor hx
              set ycor hy
              set hub-id counter
              set hub-name gis:property-value feat "NAME"
              set hub-category gis:property-value feat "CATEGORY"
              set hub-capacity gis:property-value feat "CAPACITY"
              ;; RISK_SCORE not in shapefile – derive from category
              set hub-risk-score (ifelse-value
                hub-category = "Healthcare"  [ 0.6 ]
                hub-category = "Market"      [ 0.9 ]
                hub-category = "Transit"     [ 0.8 ]
                hub-category = "Education"   [ 0.7 ]
                hub-category = "Religious"   [ 0.75 ]
                hub-category = "Commercial"  [ 0.85 ]
                                             [ 0.5 ])
              set visitors-count 0
              set infections-generated 0
              set is-closed? false

              ;; Style hub icon by category
              style-hub-icon self
              set counter counter + 1
            ]
          ]
        ]
      ]
    ]
  ]
end

to style-hub-icon [ h ]
  ask h [
    ifelse hub-category = "Healthcare" [
      set shape "plus"
      set color red
      set size 2.2
    ] [
      ifelse hub-category = "Market" [
        set shape "box"
        set color orange
        set size 2.0
      ] [
        ifelse hub-category = "Transit" [
          set shape "triangle"
          set color yellow
          set size 2.2
        ] [
          ifelse hub-category = "Education" [
            set shape "circle"
            set color sky
            set size 1.8
          ] [
            ifelse hub-category = "Religious" [
              set shape "star"
              set color violet
              set size 1.6
            ] [
              set shape "circle"
              set color cyan
              set size 1.4
            ]
          ]
        ]
      ]
    ]
  ]
end

to setup-population
  ;; Count wards from GIS shapefile
  let ward-features gis:feature-list-of wards-dataset
  let num-wards length ward-features
  let agents-per-ward max (list 1 (round (initial-population / num-wards)))

  ;; Place equal number of agents in each ward
  let ward-num 1
  repeat num-wards [
    let this-ward-patches patches with [ ward-no = ward-num ]
    if any? this-ward-patches [
      create-people agents-per-ward [
        ;; Random patch inside this ward
        let p one-of this-ward-patches
        move-to p
        set home-patch-var p
        set current-target-patch p
        set mobility-phase "home"
        set dwell-hours-left 0

        ;; Health status
        set health-status "S"
        set days-exposed 0
        set days-infected 0
        set latent-duration (latent-period-days * 24 + random 24)
        set infectious-duration (infectious-period-days * 24 + random 48)
        set is-isolated? false
        set secondary-cases 0

        ;; Behavioral traits
        set compliance-score (0.50 + random-float 0.50)
        set is-mask-wearer? (random-float 100.0 < mask-coverage-pct)
        set ward-id ward-num

        ;; Assign primary activity hub (prefer closer hubs)
        let nearby-hubs hubs in-radius 30
        ifelse any? nearby-hubs [
          set assigned-hub-var one-of nearby-hubs
        ] [
          set assigned-hub-var one-of hubs
        ]

        ;; Visual appearance
        set shape "person"
        set color 55  ;; Green for Susceptible
        set size 1.2
      ]
    ]
    set ward-num ward-num + 1
  ]

  ;; Seed initial infections spread across all municipality people
  let all-people people with [ ward-id > 0 ]
  let seed-targets []
  ifelse count all-people >= initial-infected [
    set seed-targets n-of initial-infected all-people
  ] [
    set seed-targets n-of initial-infected people
  ]

  ask seed-targets [
    set health-status "I"
    set color red
    set days-infected (random 24)
  ]

  set cumulative-cases initial-infected
end

;; Helper: Weighted random selection
to-report one-of-weighted [ agent-set weight-reporter ]
  let total-w sum [ pop-density ] of agent-set
  if total-w <= 0 [ report one-of agent-set ]
  let threshold random-float total-w
  let running 0.0
  let chosen nobody
  ask agent-set [
    if chosen = nobody [
      set running running + pop-density
      if running >= threshold [
        set chosen self
      ]
    ]
  ]
  ifelse chosen != nobody [ report chosen ] [ report one-of agent-set ]
end

;; ==========================================
;; MAIN SIMULATION CYCLE
;; ==========================================

to go
  ;; Check completion condition
  if count-I = 0 and count-E = 0 and ticks > 48 [
    print (word "Epidemic Extinguished at Day " simulation-day "! Final Attack Rate: " precision ((cumulative-cases / count people) * 100) 1 "%")
    stop
  ]

  ;; Update clocks
  set hour-of-day (ticks mod ticks-per-day)
  set simulation-day (floor (ticks / ticks-per-day) + 1)

  ;; Dynamic Policy Checks
  evaluate-interventions

  ;; Update Mobility & Movements
  simulate-daily-mobility

  ;; Disease Transmission
  simulate-transmission

  ;; Disease Progression (E -> I -> R)
  update-disease-progression

  ;; Active Testing & Isolation
  perform-testing-and-isolation

  ;; Update Metrics & Graphics
  update-epidemic-metrics
  if hour-of-day = 0 [
    update-visual-display
  ]

  tick
end

;; ==========================================
;; INTERVENTION & POLICY ENGINE
;; ==========================================

to evaluate-interventions
  ;; Auto-trigger lockdown if threshold exceeded
  if auto-lockdown-threshold > 0 and count-I >= auto-lockdown-threshold and not lockdown-active? [
    set lockdown-active? true
    print (word "ALERT: Auto-Lockdown Triggered on Day " simulation-day " due to " count-I " active cases!")
  ]

  ;; Update hub closure status
  ask hubs [
    ifelse markets-closed? and (hub-category = "Market" or hub-category = "Transit") [
      set is-closed? true
      set color 5  ;; Dark gray
    ] [
      set is-closed? false
      style-hub-icon self
    ]
  ]
end

;; ==========================================
;; MOBILITY ENGINE
;; ==========================================

to simulate-daily-mobility
  ;; Diurnal Schedule:
  ;; Hours 0-7: Night (all at home)
  ;; Hours 8-9: Morning Commute to Hub
  ;; Hours 10-16: Daytime Activity at Hub
  ;; Hours 17-18: Evening Commute back to Home
  ;; Hours 19-23: Evening at Home/Neighborhood

  ask people [
    ifelse is-isolated? [
      ;; Isolated agents stay at home or hospital
      set mobility-phase "home"
      move-to home-patch-var
    ] [
      ifelse lockdown-active? and (random-float 100.0 < (lockdown-compliance-pct * compliance-score)) [
        ;; Under lockdown, compliant citizens remain at home
        set mobility-phase "home"
        move-to home-patch-var
      ] [
        ;; Normal schedule
        ifelse hour-of-day >= 8 and hour-of-day <= 16 [
          ;; Heading to or at activity hub
          if assigned-hub-var != nobody and not [is-closed?] of assigned-hub-var [
            set mobility-phase "at-hub"
            ;; Move towards hub with slight jitter
            move-to assigned-hub-var
            fd (random-float 0.8)
          ]
        ] [
          ;; Heading home or at home
          set mobility-phase "home"
          move-to home-patch-var
          if hour-of-day >= 19 and hour-of-day <= 22 [
            ;; Local evening neighborhood walk
            rt (random 360)
            fd (random-float 0.5)
          ]
        ]
      ]
    ]
  ]

  ;; Update hub occupant counters
  ask hubs [
    set visitors-count count people-here
  ]
end

;; ==========================================
;; TRANSMISSION ENGINE
;; ==========================================

to simulate-transmission
  set recent-new-infections 0

  ;; 1. Hub Transmission (Crowded Indoor Environments)
  ask hubs with [ not is-closed? and visitors-count > 1 ] [
    let infected-visitors people-here with [ health-status = "I" and not is-isolated? ]
    let susceptible-visitors people-here with [ health-status = "S" ]

    if any? infected-visitors and any? susceptible-visitors [
      let num-inf count infected-visitors
      ;; Mask efficacy reduction
      let mask-protection-factor 1.0
      ;; Hub transmission risk formula
      let p-trans (1.0 - ((1.0 - (beta-hub-base * hub-risk-score * hub-crowding-factor / 2.0)) ^ num-inf))

      ask susceptible-visitors [
        let eff-p p-trans
        if is-mask-wearer? [ set eff-p eff-p * (1.0 - (mask-efficacy-pct / 100.0)) ]
        if random-float 1.0 < eff-p [
          set health-status "E"
          set days-exposed 0
          set color 45  ;; Yellow
          set recent-new-infections recent-new-infections + 1
          set cumulative-cases cumulative-cases + 1
          ask patch-here [ set cumulative-patch-cases cumulative-patch-cases + 1 ]
          ask one-of infected-visitors [
            set secondary-cases secondary-cases + 1
          ]
          ask myself [
            set infections-generated infections-generated + 1
          ]
        ]
      ]
    ]
  ]

  ;; 2. Street / Neighborhood Transmission
  let active-infectious people with [ health-status = "I" and not is-isolated? ]
  ask active-infectious [
    let nearby-susceptibles (people in-radius street-proximity-radius) with [ health-status = "S" ]
    if any? nearby-susceptibles [
      ask nearby-susceptibles [
        let p-street beta-street
        if [is-mask-wearer?] of myself [ set p-street p-street * (1.0 - (mask-efficacy-pct / 100.0)) ]
        if is-mask-wearer? [ set p-street p-street * (1.0 - (mask-efficacy-pct / 100.0)) ]
        if random-float 1.0 < p-street [
          set health-status "E"
          set days-exposed 0
          set color 45  ;; Yellow
          set recent-new-infections recent-new-infections + 1
          set cumulative-cases cumulative-cases + 1
          ask patch-here [ set cumulative-patch-cases cumulative-patch-cases + 1 ]
          ask myself [
            set secondary-cases secondary-cases + 1
          ]
        ]
      ]
    ]
  ]
end

;; ==========================================
;; DISEASE PROGRESSION & TESTING
;; ==========================================

to update-disease-progression
  ask people [
    if health-status = "E" [
      set days-exposed days-exposed + 1
      if days-exposed >= latent-duration [
        set health-status "I"
        set days-infected 0
        set color red
      ]
    ]

    if health-status = "I" [
      set days-infected days-infected + 1
      if days-infected >= infectious-duration [
        set health-status "R"
        set color sky  ;; Blue
        set is-isolated? false
      ]
    ]
  ]
end

to perform-testing-and-isolation
  if quarantine-active? [
    let unisolated-infected people with [ health-status = "I" and not is-isolated? ]
    ask unisolated-infected [
      ;; Daily detection probability scaled to hourly ticks
      let hourly-detect-prob (testing-quarantine-pct / 100.0) / 24.0
      if random-float 1.0 < hourly-detect-prob [
        set is-isolated? true
        set color 5  ;; Gray indicates isolated
        ;; Check hospital capacity
        if hospitalized-cases < hospital-capacity [
          set hospitalized-cases hospitalized-cases + 1
        ]
      ]
    ]
  ]

  ;; Decrement hospitalized as they recover
  let active-hosp count people with [ health-status = "I" and is-isolated? ]
  set hospitalized-cases min (list active-hosp hospital-capacity)
end

;; ==========================================
;; METRICS & DISPLAY
;; ==========================================

to update-epidemic-metrics
  set count-S count people with [ health-status = "S" ]
  set count-E count people with [ health-status = "E" ]
  set count-I count people with [ health-status = "I" ]
  set count-R count people with [ health-status = "R" ]

  if count-I > peak-infected [
    set peak-infected count-I
    set peak-day simulation-day
  ]

  ;; Estimate Effective Reproduction Number Rt
  let recovered-sample people with [ health-status = "R" or (health-status = "I" and days-infected > (infectious-duration / 2)) ]
  ifelse any? recovered-sample [
    set effective-Rt precision (mean [ secondary-cases ] of recovered-sample) 2
  ] [
    set effective-Rt 1.85
  ]
end

to update-visual-display
  ifelse display-layer = "Population Density" [
    ask patches [
      ;; Only colour patches inside a ward – outside stays black
      ifelse ward-no > 0 [
        set pcolor 37   ;; uniform tan for all municipality patches
      ] [
        set pcolor black
      ]
    ]
    ;; Draw ward boundaries in white, roads in dark
    gis:set-drawing-color white
    gis:draw wards-dataset 0.8
    gis:set-drawing-color 35
    gis:draw roads-dataset 0.8
  ] [
    ifelse display-layer = "Infection Heatmap" [
      let max-c max [ cumulative-patch-cases ] of patches
      if max-c = 0 [ set max-c 1 ]
      ask patches [
        ifelse cumulative-patch-cases > 0 [
          set pcolor scale-color red cumulative-patch-cases 0 max-c
        ] [
          set pcolor 0
        ]
      ]
      gis:set-drawing-color white
      gis:draw boundary-dataset 1.5
    ] [
      ifelse display-layer = "Road Network" [
        ask patches [ set pcolor black ]
        gis:set-drawing-color yellow
        gis:draw roads-dataset 1.2
        gis:set-drawing-color red
        gis:draw boundary-dataset 2.0
      ] [
        ask patches [ set pcolor black ]
      ]
    ]
  ]
end

;; Quick action buttons
to enact-lockdown
  set lockdown-active? not lockdown-active?
  print (word "Lockdown status toggled to: " lockdown-active?)
end

to close-market-hubs
  set markets-closed? not markets-closed?
  print (word "Markets/Transit closure toggled to: " markets-closed?)
end
]]></code>
  <widgets>
    <view x="210" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="0" height="520" showTickCounter="true" patchSize="6.2" fontSize="10" wrappingAllowedY="false" width="520" tickCounterLabel="ticks (hours)" maxPycor="80" updateMode="0" maxPxcor="80" minPxcor="0"></view>
    <button x="10" y="10" height="38" disableUntilTicks="false" forever="false" kind="Observer" width="90">setup</button>
    <button x="105" y="10" height="38" disableUntilTicks="true" forever="true" kind="Observer" width="95">go</button>
    <button x="10" y="52" height="35" disableUntilTicks="true" forever="false" kind="Observer" width="90">enact-lockdown</button>
    <button x="105" y="52" height="35" disableUntilTicks="true" forever="false" kind="Observer" width="95">close-market-hubs</button>
    <chooser x="10" y="90" height="60" variable="display-layer" current="0" width="190" display="display-layer">
      <choice type="string" value="Population Density"></choice>
      <choice type="string" value="Road Network"></choice>
      <choice type="string" value="Infection Heatmap"></choice>
      <choice type="string" value="None"></choice>
    </chooser>
    <slider x="10" step="100" y="150" max="5000" width="190" display="initial-population" height="50" min="200" direction="Horizontal" default="1500.0" variable="initial-population"></slider>
    <slider x="10" step="1" y="200" max="50" width="190" display="initial-infected" height="50" min="1" direction="Horizontal" default="10.0" variable="initial-infected"></slider>
    <slider x="10" step="0.01" y="250" max="0.40" width="190" display="beta-street" height="50" min="0.01" direction="Horizontal" default="0.08" variable="beta-street"></slider>
    <slider x="10" step="0.01" y="300" max="0.60" width="190" display="beta-hub-base" height="50" min="0.05" direction="Horizontal" default="0.2" variable="beta-hub-base"></slider>
    <slider x="10" step="0.1" y="350" max="5.0" width="190" display="hub-crowding-factor" height="50" min="1.0" direction="Horizontal" default="2.5" variable="hub-crowding-factor"></slider>
    <slider x="10" step="0.1" y="400" max="4.0" width="190" display="street-proximity-radius" height="50" min="0.5" direction="Horizontal" default="1.5" variable="street-proximity-radius"></slider>
    <slider x="10" step="1" y="450" max="7" width="190" display="latent-period-days" height="50" min="1" direction="Horizontal" default="3.0" variable="latent-period-days"></slider>
    <slider x="10" step="1" y="500" max="25" width="190" display="infectious-period-days" height="50" min="5" direction="Horizontal" default="12.0" variable="infectious-period-days"></slider>
    <slider x="10" step="5" y="550" max="100" width="190" display="mask-coverage-pct" height="50" min="0" direction="Horizontal" default="40.0" variable="mask-coverage-pct"></slider>
    <slider x="10" step="5" y="600" max="100" width="190" display="mask-efficacy-pct" height="50" min="0" direction="Horizontal" default="65.0" variable="mask-efficacy-pct"></slider>
    <slider x="10" step="5" y="650" max="100" width="190" display="testing-quarantine-pct" height="50" min="0" direction="Horizontal" default="35.0" variable="testing-quarantine-pct"></slider>
    <slider x="10" step="5" y="700" max="100" width="190" display="lockdown-compliance-pct" height="50" min="0" direction="Horizontal" default="75.0" variable="lockdown-compliance-pct"></slider>
    <slider x="10" step="10" y="750" max="500" width="190" display="auto-lockdown-threshold" height="50" min="0" direction="Horizontal" default="0.0" variable="auto-lockdown-threshold"></slider>
    <switch x="210" y="540" height="40" on="true" variable="lockdown-active?" width="120" display="lockdown-active?"></switch>
    <switch x="335" y="540" height="40" on="false" variable="markets-closed?" width="125" display="markets-closed?"></switch>
    <switch x="465" y="540" height="40" on="true" variable="quarantine-active?" width="130" display="quarantine-active?"></switch>
    <monitor x="210" precision="0" y="590" height="60" fontSize="11" width="100" display="Simulation Day">simulation-day</monitor>
    <monitor x="305" precision="0" y="590" height="60" fontSize="11" width="100" display="Infected (I)">count-I</monitor>
    <monitor x="395" precision="0" y="590" height="60" fontSize="11" width="100" display="Exposed (E)">count-E</monitor>
    <monitor x="480" precision="0" y="590" height="60" fontSize="11" width="100" display="Recovered (R)">count-R</monitor>
    <monitor x="570" precision="1" y="590" height="60" fontSize="11" width="100" display="Attack Rate %">precision ((cumulative-cases / count people) * 100) 1</monitor>
    <monitor x="670" precision="2" y="590" height="60" fontSize="11" width="100" display="Rt">effective-Rt</monitor>
    <plot x="740" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="Agents" y="10" xMin="0.0" height="250" legend="true" xMax="60.0" yMin="0.0" width="460" xAxis="Days" display="Nedumangad Epidemic Trajectory (SEIR)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Susceptible (S)" color="-13345367" legend="true">
        <setup></setup>
        <update>plot count-S</update>
      </pen>
      <pen interval="1.0" mode="0" display="Exposed (E)" color="-267413" legend="true">
        <setup></setup>
        <update>plot count-E</update>
      </pen>
      <pen interval="1.0" mode="0" display="Infected (I)" color="-267413" legend="true">
        <setup></setup>
        <update>plot count-I</update>
      </pen>
      <pen interval="1.0" mode="0" display="Recovered (R)" color="-13840019" legend="true">
        <setup></setup>
        <update>plot count-R</update>
      </pen>
    </plot>
    <plot x="740" autoPlotX="true" yMax="3.0" autoPlotY="true" yAxis="Rt Value" y="270" xMin="0.0" height="260" legend="true" xMax="60.0" yMin="0.0" width="460" xAxis="Days" display="Effective Reproduction Number (Rt)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Rt" color="-267413" legend="true">
        <setup></setup>
        <update>plot effective-Rt</update>
      </pen>
      <pen interval="1.0" mode="0" display="Threshold (1.0)" color="-16777216" legend="true">
        <setup></setup>
        <update>plot 1.0</update>
      </pen>
    </plot>
  </widgets>
  <info><![CDATA[## WHAT IS IT?
A Geographic Information System (GIS)-integrated Agent-Based Model (ABM) for simulating the spatial spread and containment of an infectious epidemic in Nedumangad Municipality, Thiruvananthapuram district, Kerala, India.

## HOW IT WORKS
1. Spatially Explicit GIS Landscape:
   - Municipal boundary (32.52 sq.km) and 39 administrative wards.
   - Real OpenStreetMap (OSM) multi-tier road network (primary, secondary, tertiary, residential).
   - 205 surveyed activity hubs (Taluk Hospital, Community Health Centers, Valiya Chanda Market, KSRTC Bus Terminal, schools, temples, mosques, churches).
   - ESRI ASCII raster population distribution surface reflecting real census demographics (~60,161 population).

2. Agent-Based Disease & Mobility Dynamics:
   - S-E-I-R Epidemiological Framework (Susceptible -> Exposed -> Infectious -> Recovered).
   - Diurnal human mobility: home sleeping, morning commuting along road network, daytime mixing at activity hubs, evening return.
   - Dual transmission modes: proximity street encounters and hub-based superspreading.
   - Non-Pharmaceutical Interventions (NPIs): Municipal lockdowns, selective market closures, testing and active case quarantine.

## HOW TO USE IT
1. Click `setup` to load GIS shapefiles, population raster, and initialize the agent population.
2. Click `go` to commence the epidemic simulation.
3. Use the `enact-lockdown` and `close-market-hubs` buttons or switches to evaluate intervention efficacy in flattening the curve.
4. Use the `display-layer` dropdown to toggle between Population Density, Road Network, and Infection Heatmap views.

## AUTHORS & CITATION
Antigravity Modeling Team / GIS-ABM Epidemic Research Project for Nedumangad Municipality, Kerala.
